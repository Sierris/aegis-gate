# ---------------------------------------------------------------------------
# AEGIS — referencia de configuración. Copiar a `.env` (que está en .gitignore)
# y completar. NUNCA commitear `.env` con valores reales.
#
# Convención: todo lo del servidor lleva prefijo AEGIS_, todo lo del cliente
# también (un único namespace, sin colisiones con el entorno del desarrollador).
# ---------------------------------------------------------------------------

# --- Servidor --------------------------------------------------------------
AEGIS_ENV=local                       # local | ci | prod
AEGIS_LISTEN=127.0.0.1:8088
AEGIS_PUBLIC_URL=http://127.0.0.1:8088
AEGIS_DATABASE_URL=sqlite+aiosqlite:///./.aegis/aegis.db

# Clave de firma de attestations (Ed25519, PKCS#8 PEM en base64 o ruta a fichero).
# Rotación: se publica la nueva en /v1/keys con not_before y se mantiene la
# anterior hasta que expiren las attestations emitidas con ella.
AEGIS_SIGNING_KEY_PATH=./.aegis/keys/attestation_ed25519.pem
AEGIS_ATTESTATION_TTL_SECONDS=2592000
AEGIS_AUDIT_HMAC_KEY=                 # vacío => cadena de auditoría sin HMAC (solo demo)

# --- Autenticación (OAuth 2.0 Device Authorization Grant) ------------------
AEGIS_OAUTH_CLIENT_ID=aegis-cli
AEGIS_OAUTH_PROVIDER=github           # github | local
AEGIS_OAUTH_GITHUB_CLIENT_ID=
AEGIS_OAUTH_GITHUB_CLIENT_SECRET=
AEGIS_ACCESS_TOKEN_TTL_SECONDS=3600
AEGIS_DEVICE_CODE_TTL_SECONDS=600

# --- LLM -------------------------------------------------------------------
# El proveedor se elige server-side; el cliente nunca ve estas credenciales.
AEGIS_LLM_PROVIDER=openai             # openai | anthropic | ollama | fake
AEGIS_LLM_MODEL=gpt-4.1-mini
AEGIS_LLM_API_KEY=
AEGIS_LLM_BASE_URL=
AEGIS_LLM_TIMEOUT_SECONDS=45
AEGIS_LLM_MAX_OUTPUT_TOKENS=2000
AEGIS_LLM_TEMPERATURE=0
AEGIS_PROMPT_VERSION=v1
AEGIS_PROMPT_DIR=./prompts

# --- Cliente (hook) --------------------------------------------------------
AEGIS_SERVER_URL=http://127.0.0.1:8088
AEGIS_TOKEN_CACHE=~/.config/aegis/token.json
AEGIS_FAIL_MODE=closed                # closed | open  (política local si el server no responde)
AEGIS_TIMEOUT_SECONDS=60
AEGIS_VERBOSE=0
