# ---------------------------------------------------------------------------
# AEGIS — referencia de configuración. Copiar a `.env` (gitignored) y completar.
# NUNCA commitear `.env` con valores reales. Todo lleva prefijo AEGIS_.
# ---------------------------------------------------------------------------

# --- Servidor --------------------------------------------------------------
AEGIS_ENV=local                       # local | ci | prod
AEGIS_LISTEN=127.0.0.1:8088
# URL *pública* (la que ve el usuario en el device flow y la que se usa como
# `iss` del JWT). Si está detrás de un proxy, NO es la dirección de bind.
AEGIS_PUBLIC_URL=http://127.0.0.1:8088
AEGIS_DB_PATH=./.aegis/aegis.db

# Clave de firma Ed25519 (PKCS#8 PEM). Se crea con 0600 en el primer arranque y
# firma tanto access tokens como (paso 5) las attestations.
AEGIS_SIGNING_KEY_PATH=./.aegis/keys/aegis_ed25519.pem

# Vigencias.
AEGIS_ACCESS_TOKEN_TTL_SECONDS=3600
AEGIS_REFRESH_TOKEN_TTL_SECONDS=2592000
AEGIS_DEVICE_CODE_TTL_SECONDS=600
AEGIS_DEVICE_INTERVAL_SECONDS=5
AEGIS_CLOCK_SKEW_SECONDS=30

# --- Autenticación ---------------------------------------------------------
AEGIS_AUTH_PROVIDER=local             # local | github
AEGIS_OAUTH_CLIENT_ID=aegis-cli
# Scopes que el servidor está dispuesto a emitir (el cliente puede pedir menos,
# nunca más: se aplica intersección y el downgrade queda auditado).
AEGIS_GRANTED_SCOPES_DEFAULT='["analyze"]'
AEGIS_GRANTED_SCOPES_MAX='["analyze","analyze:any"]'
# Repos autorizados. Vacío = cualquiera. En prod es obligatorio.
AEGIS_ALLOWED_REPOS='[]'

# GitHub como IdP (intercambio de token upstream).
AEGIS_GITHUB_CLIENT_ID=
AEGIS_GITHUB_CLIENT_SECRET=
AEGIS_GITHUB_API_URL=https://api.github.com

# Anti-abuso del device flow.
AEGIS_DEVICE_CODE_ATTEMPT_LIMIT=10
AEGIS_DEVICE_CODE_ATTEMPT_WINDOW_SECONDS=300

# --- LLM (Command Code Provider API) ---------------------------------------
AEGIS_LLM_PROVIDER=commandcode         # commandcode | fake (fake = solo CI/offline)
AEGIS_LLM_MODEL=gpt-6-luna             # ver: aegis models
AEGIS_LLM_BASE_URL=https://api.commandcode.ai/provider/v1
# Si está vacío se resuelve, en orden: AEGIS_LLM_API_KEY -> COMMAND_CODE_API_KEY
# -> ~/.commandcode/auth.json -> ~/.pi/agent/auth.json
AEGIS_LLM_API_KEY=
AEGIS_LLM_WIRE=auto                    # auto (según catálogo) | chat | messages
AEGIS_LLM_TIMEOUT_SECONDS=60
AEGIS_LLM_MAX_OUTPUT_TOKENS=4000       # los modelos de razonamiento consumen aquí
AEGIS_LLM_TEMPERATURE=0
AEGIS_LLM_ZDR=1                        # x-cmd-zdr: no retener el código enviado

# --- Motor de análisis -----------------------------------------------------
AEGIS_PROMPT_DIR=./prompts
AEGIS_PROMPT_FILE=analyze.v1.md
AEGIS_ANALYSIS_CACHE_ENABLED=1
AEGIS_ANALYSIS_CACHE_TTL_SECONDS=604800
# Si el modelo no confirma lo que el detector determinista marcó: bloquear.
AEGIS_STRICT_CROSS_CHECK=1

# --- Cliente (hook / CLI) --------------------------------------------------
AEGIS_SERVER_URL=http://127.0.0.1:8088
# Cache del refresh token: keyring si está disponible, si no fichero 0600.
AEGIS_TOKEN_CACHE=~/.config/aegis/token.json
AEGIS_FAIL_MODE=closed                # closed | open  (política si el server no responde)
AEGIS_TIMEOUT_SECONDS=60
AEGIS_CONNECT_TIMEOUT_SECONDS=5
AEGIS_VERBOSE=0
# AEGIS_TOKEN=                        # solo CI. AEGIS_ALLOW_ENV_TOKEN=0 lo prohíbe.
AEGIS_ALLOW_ENV_TOKEN=1
