{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/analysis.v1.json",
  "title": "AEGIS analysis result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "severity", "confidence", "path", "title", "explanation", "remediation", "evidence"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["A01:2021", "A02:2021", "A03:2021", "A10:2021"]
          },
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{3,32}$",
            "description": "Short stable identifier for the pattern, e.g. A03-CMDI-001. Reused across commits for grouping/metrics."
          },
          "cwe": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1200
          },
          "severity": {
            "type": "string",
            "enum": ["info", "low", "medium", "high", "critical"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "explanation": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1500
          },
          "remediation": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1500
          },
          "patch": {
            "type": ["string", "null"],
            "maxLength": 3000
          },
          "evidence": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "Verbatim single line copied from the fragment. Verified server-side; a finding whose evidence cannot be located is discarded."
          }
        }
      }
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 500,
      "description": "Optional reviewer note for the human, e.g. why a suspicious sink was not reported."
    }
  }
}
